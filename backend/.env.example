# Copy to backend/.env and fill in. Never commit the real .env.

# --- Required ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=babybabel
# At least 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Accounts ---
ADMIN_EMAIL=you@example.com
ADMIN_INITIAL_PASSWORD=
# Password for the two sample tutors (sofia@ / marie@babybabel.dev). Leave EMPTY in production
# (a random one is generated). The integration tests expect SEED_TUTOR_PASSWORD=password123.
SEED_TUTOR_PASSWORD=
# true = new accounts must confirm their email before booking, messaging or posting.
REQUIRE_EMAIL_VERIFICATION=false
# Local development only: print verification / reset codes to the server log.
DEV_LOG_EMAIL_CODES=false

# --- Payments ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# MUST be false in production — otherwise anyone can mark their own booking as paid.
ENABLE_MOCK_CONFIRM=true

# --- Booking policy ---
CANCEL_FULL_REFUND_HOURS=24    # parents cancelling at least this long before get a full refund
RESCHEDULE_MIN_HOURS=24        # sessions can be moved up to this long before they start
TUTOR_RESPONSE_HOURS=24        # tutors have this long to accept a paid request, else it's refunded
PENDING_PAYMENT_MINUTES=30     # unpaid bookings release the slot after this

# --- W-9 TIN encryption (comma-separated Fernet keys, newest first) ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
W9_ENCRYPTION_KEYS=
# How long W-9s are kept after a tutor deletes their account (IRS: 4 years).
W9_RETENTION_DAYS=1460

# --- Emergent integrations (storage + email) ---
EMERGENT_LLM_KEY=
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=Babybabel
EMAIL_REPLY_TO=
SAFETY_ALERT_EMAIL=

# --- Push notifications (Expo push service) ---
PUSH_ENABLED=true
# Only needed if you turn on "enhanced push security" in your Expo account.
EXPO_ACCESS_TOKEN=

# --- Web / SEO ---
# Public address of the web app, used in share pages and the sitemap (no trailing slash).
PUBLIC_WEB_URL=https://babybabel.example

# --- Optional ---
CORS_ORIGINS=
CORS_ORIGIN_REGEX=
MAX_UPLOAD_BYTES=10485760
ACCESS_TOKEN_MINUTES=10080
# Set true to stop the in-process background jobs (e.g. when a separate worker runs them).
DISABLE_BACKGROUND_WORKERS=false
