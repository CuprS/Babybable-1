# Caddy: automatic HTTPS (Let's Encrypt), the static website, and /api → the API container.
# DOMAIN and ACME_EMAIL come from deploy/.env via docker-compose.yml.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# Content-Security-Policy: scripts only from this site (plus the one fixed redirect script on
	# /api/share pages, allowed by its hash — see backend/routes/seo.py). Injected scripts can't run,
	# and data can only be sent back to this site. Only other sites may not embed us (clickjacking).
	# If you add a third-party service (e.g. Stripe's payment form), add its domains here.
	# Files under /api/files are excluded so browsers' built-in PDF viewers keep working.
	@csp not path /api/files/*
	header @csp Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-TYm6zsUzC2a2Nz1KPCd/k0ch4ZuI3ZqqHtCUVbdv2fo='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org https://images.unsplash.com https://images.pexels.com; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; worker-src 'self' blob:; manifest-src 'self'"

	# Uploads are capped at 10 MB by the API; allow a little headroom for form encoding.
	request_body {
		max_size 12MB
	}

	handle /api/* {
		reverse_proxy api:8001
	}

	handle {
		root * /srv/web

		# Fingerprinted build files never change: cache them for a year.
		@immutable path /_expo/static/* /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# The app shell must always be fresh so new deploys show up immediately.
		@shell path / /index.html
		header @shell Cache-Control "no-cache"

		# Single-page app: unknown paths load index.html and the app shows the right screen.
		try_files {path} {path}.html /index.html
		file_server
	}
}

# Optional: send www.yourdomain to yourdomain (needs a DNS record for www too).
# www.{$DOMAIN} {
# 	redir https://{$DOMAIN}{uri} permanent
# }
