# Production settings for deploy/docker-compose.yml. setup.sh copies this to deploy/.env and
# fills in every "generated" value. Never commit deploy/.env. Passwords must be letters/digits only
# (they go inside a database URL) — the generated ones are.

# --- Your site ---
DOMAIN=babybabel.example.com          # DNS A record must point at this server first
ACME_EMAIL=you@example.com            # Let's Encrypt contacts this address about certificates

# --- Database (generated) ---
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=

# --- App secrets (generated) ---
JWT_SECRET=
W9_ENCRYPTION_KEYS=

# --- Admin account (created on first start) ---
ADMIN_EMAIL=you@example.com
ADMIN_INITIAL_PASSWORD=               # generated; only creates the account. Change it with admin_tools.py, then delete this line

# --- Uploads ---
# local = this server's disk (backed up nightly by backup.sh)
# s3    = Hetzner Object Storage (or any S3-compatible bucket). Create a bucket and S3 credentials
#         in the Hetzner Console → Object Storage, then fill in the four values below.
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com   # use your bucket's location: fsn1, nbg1, hel1
S3_REGION=fsn1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Email (verification codes, password resets, safety alerts) ---
# Hetzner blocks outgoing ports 25 and 465 on new accounts, so use Resend (HTTPS) or SMTP on port 587.
EMAIL_PROVIDER=resend
EMAIL_FROM=Babybabel <hello@babybabel.example.com>   # must be verified with your email provider
EMAIL_REPLY_TO=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SAFETY_ALERT_EMAIL=

# --- Text message reminders (optional; leave SMS_PROVIDER empty to switch texts off) ---
# Twilio: get the SID and token from console.twilio.com, and a number (or Messaging Service SID "MG…").
# US numbers need A2P 10DLC registration in Twilio before texts are delivered.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Payments (Stripe — mocked for now) ---
# Leave the Stripe keys empty while payments are mocked: bookings go through a pretend payment
# and no card is charged. When real payments are built, add your Stripe keys and set
# ENABLE_MOCK_CONFIRM=false so only Stripe can mark a booking as paid.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
ENABLE_MOCK_CONFIRM=true

# --- Keep data minimal: automatic deletion (days / hours) ---
NOTIFICATION_RETENTION_DAYS=90
EVENT_RETENTION_DAYS=90
PUSH_TOKEN_RETENTION_DAYS=180
ORPHAN_UPLOAD_HOURS=24

# --- Behaviour ---
REQUIRE_EMAIL_VERIFICATION=true
SEED_SAMPLE_TUTORS=false
PUSH_ENABLED=true

# --- Backups ---
# Encrypts every backup (generated by setup.sh). Keep a copy in your password manager:
# without it the backups can't be restored.
BACKUP_ENCRYPTION_PASSPHRASE=
# Off-site copies (optional but recommended):
# A separate Hetzner Object Storage bucket for nightly database backups.
BACKUP_S3_BUCKET=
BACKUP_KEEP_DAYS=14
